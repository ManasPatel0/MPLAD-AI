# MPLAD-AI Backend Environment Configuration
# SIH 2026 - Problem Statement ID: 26102
# AI-Powered MPLADS Monitoring & Accountability System

# Application Settings
PROJECT_NAME="MPLAD-AI API Gateway"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL 15+ / Neon Cloud PostgreSQL)
# Option 1: Local PostgreSQL Default
DATABASE_URL="postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/mplads_db"
DATABASE_SYNC_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5432/mplads_db"
DB_CONNECT_TIMEOUT_SECONDS=10.0

# Option 2: Neon Cloud PostgreSQL - Direct Connection
# (Replace with your actual endpoint from Neon console in your local .env)
# DATABASE_URL="postgresql+asyncpg://<neon_user>:<neon_password>@ep-<project-id>.<region>.aws.neon.tech/<dbname>?ssl=require"
# DATABASE_SYNC_URL="postgresql://<neon_user>:<neon_password>@ep-<project-id>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Option 3: Neon Cloud PostgreSQL - Pooled Connection (PgBouncer)
# Recommended for serverless autoscaling / high concurrency
# DATABASE_URL="postgresql+asyncpg://<neon_user>:<neon_password>@ep-<project-id>-pooler.<region>.aws.neon.tech/<dbname>?ssl=require"
# DATABASE_SYNC_URL="postgresql://<neon_user>:<neon_password>@ep-<project-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Security & JWT Auth
SECRET_KEY="replace-with-a-secure-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
