# MPLAD-AI Backend Environment Configuration
# SIH 2026 - Problem Statement ID: 26102

PROJECT_NAME="MPLAD-AI API Gateway"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
DATABASE_URL="postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/mplads_db"
DATABASE_SYNC_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5432/mplads_db"

# Security & JWT Auth
SECRET_KEY="replace-with-a-secure-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
