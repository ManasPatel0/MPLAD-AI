# MPLAD-AI Backend Environment Configuration
# SIH 2026 - Problem Statement ID: 26102

# Application Settings
PROJECT_NAME="MPLAD-AI API Gateway"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL 15+)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mplads_db"
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/mplads_db"

# Security & JWT Auth (Mock / Dev Secret - Update for Production)
SECRET_KEY="insecure-dev-secret-key-change-for-production-deployment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
