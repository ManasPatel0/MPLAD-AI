# MPLAD-AI Monorepo Environment Configuration Template
# SIH 2026 - Problem Statement ID: 26102

# Backend Environment
PROJECT_NAME="MPLAD-AI API Gateway"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL 15+)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=mplads_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/mplads_db"
DATABASE_SYNC_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5432/mplads_db"

# Security & Tokens
SECRET_KEY="replace-with-a-secure-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_NAME="MPLAD-AI Monitoring Portal"
